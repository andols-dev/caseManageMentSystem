
@model caseManageMentSystem.Models.Case

@{
    ViewData["Title"] = "Case Details";
}

<div class="space-y-6">

    <!-- Header -->
    <div class="flex flex-col gap-4 rounded-2xl border border-slate-800 bg-slate-900 p-6 shadow-lg shadow-slate-950/20 sm:flex-row sm:items-center sm:justify-between">

        <div>
            <p class="text-xs font-semibold uppercase tracking-[0.24em] text-cyan-400">
                Case
            </p>

            <h1 class="mt-2 text-2xl font-bold tracking-tight text-white">
                @Model.Title
            </h1>

            <p class="mt-1 text-sm text-slate-400">
                Case number:
                <span class="text-slate-300">
                    @Model.CaseNumber
                </span>
            </p>
        </div>

        <!-- Case number badge -->
        <div>
            <span class="inline-flex items-center rounded-full bg-slate-800 px-3 py-1.5 text-xs font-semibold text-slate-300 ring-1 ring-inset ring-slate-700">
                @Model.CaseNumber
            </span>
        </div>

    </div>


    <!-- Success message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="rounded-xl border border-emerald-800 bg-emerald-950/40 px-5 py-4 text-sm text-emerald-400">
            @TempData["SuccessMessage"]
        </div>
    }


    <!-- Case information -->
    <div class="overflow-hidden rounded-xl border border-slate-800 bg-slate-900 shadow-sm">

        <div class="border-b border-slate-800 px-5 py-4">
            <h2 class="text-lg font-semibold text-white">
                Case Information
            </h2>

            <p class="mt-1 text-sm text-slate-400">
                Information about this case.
            </p>
        </div>

        <dl class="divide-y divide-slate-800">

            <!-- Case number -->
            <div class="px-5 py-5 sm:grid sm:grid-cols-3 sm:gap-4">
                <dt class="text-sm font-medium text-slate-400">
                    Case number
                </dt>

                <dd class="mt-1 text-sm font-medium text-white sm:col-span-2 sm:mt-0">
                    @Model.CaseNumber
                </dd>
            </div>

            <!-- Title -->
            <div class="px-5 py-5 sm:grid sm:grid-cols-3 sm:gap-4">
                <dt class="text-sm font-medium text-slate-400">
                    Title
                </dt>

                <dd class="mt-1 text-sm text-slate-200 sm:col-span-2 sm:mt-0">
                    @Model.Title
                </dd>
            </div>

            <!-- Description -->
            <div class="px-5 py-5 sm:grid sm:grid-cols-3 sm:gap-4">
                <dt class="text-sm font-medium text-slate-400">
                    Description
                </dt>

                <dd class="mt-1 text-sm text-slate-200 sm:col-span-2 sm:mt-0">
                    @Model.Description
                </dd>
            </div>

            <!-- Case manager -->
            <div class="px-5 py-5 sm:grid sm:grid-cols-3 sm:gap-4">
                <dt class="text-sm font-medium text-slate-400">
                    Case Manager
                </dt>

                <dd class="mt-1 text-sm text-slate-200 sm:col-span-2 sm:mt-0">
                    @if (Model.CaseManager != null)
                    {
                        @Model.CaseManager.FullName
                    }
                    else
                    {
                        <span class="text-slate-500">
                            No case manager assigned
                        </span>
                    }
                </dd>
            </div>

            <!-- Created date -->
            <div class="px-5 py-5 sm:grid sm:grid-cols-3 sm:gap-4">
                <dt class="text-sm font-medium text-slate-400">
                    Created
                </dt>

                <dd class="mt-1 text-sm text-slate-200 sm:col-span-2 sm:mt-0">
                    @Model.CreatedDate.ToString("yyyy-MM-dd HH:mm")
                </dd>
            </div>

        </dl>
    </div>


    <!-- Notes -->
    <div class="overflow-hidden rounded-xl border border-slate-800 bg-slate-900 shadow-sm">

        <div class="border-b border-slate-800 px-5 py-4">

            <h2 class="text-lg font-semibold text-white">
                Notes
            </h2>

            <p class="mt-1 text-sm text-slate-400">
                Notes associated with this case.
            </p>

        </div>

        @if (Model.Notes != null && Model.Notes.Any())
        {
            <div class="divide-y divide-slate-800">

                @foreach (var note in Model.Notes)
                {
                    <div class="px-5 py-5 transition-colors hover:bg-slate-800/30">

                        <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">

                            <div class="min-w-0">
                                <p class="whitespace-pre-line text-sm leading-6 text-slate-200">
                                    @note.Text
                                </p>
                            </div>

                            <div class="shrink-0">
                                <span class="text-xs text-slate-500">
                                    @note.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                                </span>
                            </div>

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="px-5 py-12 text-center">

                <p class="font-medium text-slate-300">
                    No notes
                </p>

                <p class="mt-1 text-sm text-slate-500">
                    This case currently has no notes.
                </p>

            </div>
        }

    </div>


    <!-- Documents -->
    <div class="overflow-hidden rounded-xl border border-slate-800 bg-slate-900 shadow-sm">

        <!-- Documents header -->
        <div class="flex items-center justify-between border-b border-slate-800 px-5 py-4">

            <div>
                <h2 class="text-lg font-semibold text-white">
                    Documents
                </h2>

                <p class="mt-1 text-sm text-slate-400">
                    Documents associated with this case.
                </p>
            </div>

            <!-- Upload document -->
            <a asp-action="UploadDocument"
               asp-controller="DashBoard"
               asp-area="Client"
               asp-route-caseId="@Model.Id"
               class="inline-flex items-center rounded-full bg-cyan-500 px-4 py-2 text-sm font-semibold text-slate-950 transition-colors hover:bg-cyan-400">

                <span class="mr-2">↑</span>
                Upload

            </a>

        </div>


        @if (Model.Documents != null && Model.Documents.Any())
        {
            <!-- Documents list -->
            <div class="divide-y divide-slate-800">

                @foreach (var document in Model.Documents.OrderByDescending(d => d.UploadedAt))
                {
                    <div class="flex flex-col gap-3 px-5 py-5 transition-colors hover:bg-slate-800/30 sm:flex-row sm:items-center sm:justify-between">

                        <!-- Document information -->
                        <div class="flex min-w-0 items-center gap-3">

                            <!-- File icon -->
                            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-slate-800">

                                @if (document.ContentType == "application/pdf")
                                {
                                    <span class="text-sm font-bold text-red-400">PDF</span>
                                }
                                else if (document.ContentType.Contains("word"))
                                {
                                    <span class="text-sm font-bold text-blue-400">DOC</span>
                                }
                                else if (document.ContentType.Contains("excel"))
                                {
                                    <span class="text-sm font-bold text-emerald-400">XLS</span>
                                }
                                else if (document.ContentType.StartsWith("image/"))
                                {
                                    <span class="text-sm font-bold text-purple-400">IMG</span>
                                }
                                else
                                {
                                    <span class="text-sm font-bold text-slate-400">FILE</span>
                                }

                            </div>

                            <div class="min-w-0">

                                <p class="truncate text-sm font-medium text-slate-200">
                                    @document.FileName
                                </p>

                                <p class="mt-1 text-xs text-slate-500">
                                    @((document.FileSize / (1024.0 * 1024.0)).ToString("0.00")) MB
                                    <span class="mx-1">·</span>
                                    @document.UploadedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                                </p>

                            </div>

                        </div>


                        <!-- Download -->
                        <div class="shrink-0">

                            <a asp-action="DownloadDocument"
                               asp-controller="DashBoard"
                               asp-area="Client"
                               asp-route-documentId="@document.Id"
                               class="inline-flex items-center rounded-full bg-slate-800 px-4 py-2 text-sm font-medium text-cyan-400 transition-colors hover:bg-slate-700 hover:text-cyan-300">

                                <svg class="mr-2 h-4 w-4"
                                     fill="none"
                                     stroke="currentColor"
                                     viewBox="0 0 24 24">

                                    <path stroke-linecap="round"
                                          stroke-linejoin="round"
                                          stroke-width="2"
                                          d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1M7 10l5 5m0 0l5-5m-5 5V3" />

                                </svg>

                                Download

                            </a>

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <!-- No documents -->
            <div class="px-5 py-12 text-center">

                <p class="font-medium text-slate-300">
                    No documents
                </p>

                <p class="mt-1 text-sm text-slate-500">
                    This case currently has no uploaded documents.
                </p>

                <p class="mt-3 text-xs text-slate-500">
                    Use the Upload button above to add documents.
                </p>

            </div>
        }

    </div>


    <!-- Back -->
    <div>
        <a asp-action="Index"
           asp-controller="DashBoard"
           asp-area="Client"
           class="inline-flex items-center rounded-full bg-slate-800 px-4 py-2 text-sm font-medium text-slate-300 transition-colors hover:bg-slate-700 hover:text-white">

            ← Go back

        </a>
    </div>

</div>
