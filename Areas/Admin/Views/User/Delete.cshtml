@model ApplicationUser

@{
    ViewData["Title"] = "Delete User";
}

<div class="mx-auto max-w-2xl space-y-6">

    <!-- Page header -->
    <div class="rounded-2xl border border-slate-800 bg-slate-900 p-6 text-center shadow-lg shadow-slate-950/20">

        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-rose-400">
            Admin
        </p>

        <h1 class="mt-2 text-2xl font-bold tracking-tight text-white sm:text-3xl">
            Delete user account
        </h1>

        <p class="mx-auto mt-1 max-w-xl text-sm text-slate-400">
            Review the account before permanently deleting it.
        </p>

    </div>


    <!-- Content -->
    <div class="overflow-hidden rounded-xl border border-slate-800 bg-slate-900 shadow-sm">

        @if (Model == null)
        {
            <!-- User not found -->
            <div class="p-6 text-center">

                <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-yellow-500/10 text-yellow-400">
                    <svg class="h-6 w-6"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2">
                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M12 9v3.75m0 3h.008v.008H12V15.75zM10.5 3.75h3L21 18.75H3L10.5 3.75z" />
                    </svg>
                </div>

                <h2 class="mt-4 text-lg font-semibold text-white">
                    User not found
                </h2>

                <p class="mt-1 text-sm text-slate-400">
                    The user may already have been deleted or the ID is invalid.
                </p>

                <div class="mt-6">
                    <a asp-action="Index"
                       asp-controller="User"
                       class="inline-flex items-center justify-center rounded-full bg-slate-800 px-5 py-2.5 text-sm font-medium text-slate-300 transition-colors hover:bg-slate-700 hover:text-white">
                        Back to users
                    </a>
                </div>

            </div>
        }
        else
        {
            <!-- User information -->
            <div class="border-b border-slate-800 px-5 py-4">

                <h2 class="text-lg font-semibold text-white">
                    User information
                </h2>

                <p class="mt-1 text-sm text-slate-400">
                    You are about to delete the following account.
                </p>

            </div>


            <form asp-action="DeleteConfirmed"
                  asp-controller="User"
                  method="post">

                <input asp-for="Id" type="hidden" />


                <!-- User details -->
                <div class="p-5">

                    <div class="overflow-hidden rounded-lg border border-slate-800 bg-slate-950">

                        <!-- Username -->
                        <div class="border-b border-slate-800 px-4 py-4 sm:grid sm:grid-cols-3 sm:gap-4">
                            <dt class="text-sm font-medium text-slate-400">
                                Username
                            </dt>

                            <dd class="mt-1 text-sm font-medium text-white sm:col-span-2 sm:mt-0">
                                @Model.UserName
                            </dd>
                        </div>


                        <!-- Email -->
                        <div class="border-b border-slate-800 px-4 py-4 sm:grid sm:grid-cols-3 sm:gap-4">
                            <dt class="text-sm font-medium text-slate-400">
                                Email
                            </dt>

                            <dd class="mt-1 text-sm font-medium text-white sm:col-span-2 sm:mt-0">
                                @Model.Email
                            </dd>
                        </div>


                        <!-- First name -->
                        <div class="border-b border-slate-800 px-4 py-4 sm:grid sm:grid-cols-3 sm:gap-4">
                            <dt class="text-sm font-medium text-slate-400">
                                First name
                            </dt>

                            <dd class="mt-1 text-sm font-medium text-white sm:col-span-2 sm:mt-0">
                                @Model.FirstName
                            </dd>
                        </div>


                        <!-- Last name -->
                        <div class="px-4 py-4 sm:grid sm:grid-cols-3 sm:gap-4">
                            <dt class="text-sm font-medium text-slate-400">
                                Last name
                            </dt>

                            <dd class="mt-1 text-sm font-medium text-white sm:col-span-2 sm:mt-0">
                                @Model.LastName
                            </dd>
                        </div>

                    </div>

                </div>


                <!-- Danger zone -->
                <div class="border-y border-rose-500/20 bg-rose-500/5 px-5 py-4">

                    <div class="flex gap-3">

                        <div class="flex-shrink-0">
                            <svg class="h-5 w-5 text-rose-400"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2">
                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M12 9v3.75m0 3h.008v.008H12V15.75zM10.5 3.75h3L21 18.75H3L10.5 3.75z" />
                            </svg>
                        </div>

                        <div>
                            <p class="text-sm font-semibold text-rose-300">
                                Danger zone
                            </p>

                            <p class="mt-1 text-sm leading-6 text-slate-400">
                                Deleting this user is permanent. The account and its access rights will be removed.
                            </p>
                        </div>

                    </div>

                </div>


                <!-- Actions -->
                <div class="flex flex-col-reverse gap-3 px-5 py-4 sm:flex-row sm:justify-between">

                    <a asp-action="Index"
                       asp-controller="User"
                       class="inline-flex items-center justify-center rounded-full bg-slate-800 px-5 py-2.5 text-sm font-medium text-slate-300 transition-colors hover:bg-slate-700 hover:text-white focus:outline-none focus:ring-2 focus:ring-slate-500/50">
                        Go back
                    </a>

                    <button type="submit"
                            class="inline-flex items-center justify-center rounded-full bg-rose-500 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-rose-400 focus:outline-none focus:ring-2 focus:ring-rose-500/50">
                        Delete permanently
                    </button>

                </div>

            </form>
        }

    </div>

</div>
