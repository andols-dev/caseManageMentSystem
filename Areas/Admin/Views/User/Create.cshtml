@using caseManageMentSystem.Areas.Admin.Models
@using caseManageMentSystem.Enums
@using caseManageMentSystem.Models

@model CreateUserVM

@{
    ViewData["Title"] = "Create User";
}

<div class="mx-auto max-w-2xl space-y-6">

    <!-- Page header -->
    <div class="rounded-2xl border border-slate-800 bg-slate-900 p-6 text-center shadow-lg shadow-slate-950/20">

        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-cyan-400">
            Admin
        </p>

        <h1 class="mt-2 text-2xl font-bold tracking-tight text-white sm:text-3xl">
            Create user account
        </h1>

        <p class="mx-auto mt-1 max-w-xl text-sm text-slate-400">
            Add a new user and assign the appropriate role.
        </p>

    </div>


    <!-- Form container -->
    <div class="overflow-hidden rounded-xl border border-slate-800 bg-slate-900 shadow-sm">

        <!-- Form header -->
        <div class="border-b border-slate-800 px-5 py-4">

            <h2 class="text-lg font-semibold text-white">
                User information
            </h2>

            <p class="mt-1 text-sm text-slate-400">
                Enter the user's account information below.
            </p>

        </div>


        <!-- Form -->
        <form asp-action="Create"
              asp-controller="User"
              method="post"
              class="space-y-6 p-5">

            <!-- Name -->
            <div class="grid gap-6 sm:grid-cols-2">

                <!-- First name -->
                <div>
                    <label asp-for="FirstName"
                           class="block text-sm font-medium text-slate-300">
                        First name
                    </label>

                    <input asp-for="FirstName"
                           type="text"
                           autocomplete="given-name"
                           class="mt-2 block w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2.5 text-sm text-white placeholder-slate-500 outline-none transition focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500"
                           placeholder="First name" />

                    <span asp-validation-for="FirstName"
                          class="mt-1 block text-sm text-red-400">
                    </span>
                </div>


                <!-- Last name -->
                <div>
                    <label asp-for="LastName"
                           class="block text-sm font-medium text-slate-300">
                        Last name
                    </label>

                    <input asp-for="LastName"
                           type="text"
                           autocomplete="family-name"
                           class="mt-2 block w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2.5 text-sm text-white placeholder-slate-500 outline-none transition focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500"
                           placeholder="Last name" />

                    <span asp-validation-for="LastName"
                          class="mt-1 block text-sm text-red-400">
                    </span>
                </div>

            </div>


            <!-- Email -->
            <div>
                <label asp-for="Email"
                       class="block text-sm font-medium text-slate-300">
                    Email address
                </label>

                <input asp-for="Email"
                       type="email"
                       autocomplete="email"
                       class="mt-2 block w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2.5 text-sm text-white placeholder-slate-500 outline-none transition focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500"
                       placeholder="user@example.com" />

                <span asp-validation-for="Email"
                      class="mt-1 block text-sm text-red-400">
                </span>
            </div>


            <!-- Password -->
            <div>
                <label asp-for="Password"
                       class="block text-sm font-medium text-slate-300">
                    Password
                </label>

                <input asp-for="Password"
                       type="password"
                       autocomplete="new-password"
                       class="mt-2 block w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2.5 text-sm text-white placeholder-slate-500 outline-none transition focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500"
                       placeholder="Create a password" />

                <span asp-validation-for="Password"
                      class="mt-1 block text-sm text-red-400">
                </span>
            </div>


            <!-- Role -->
            <div>
                <label asp-for="Role"
                       class="block text-sm font-medium text-slate-300">
                    Role
                </label>

                <select asp-for="Role"
                        class="mt-2 block w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2.5 text-sm text-white outline-none transition focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500">

                    <option value="admin">
                        Admin
                    </option>

                    <option value="caseManager">
                        Case Manager
                    </option>

                    <option value="client">
                        Client
                    </option>

                </select>

                <span asp-validation-for="Role"
                      class="mt-1 block text-sm text-red-400">
                </span>
            </div>


            <!-- Submit -->
            <button type="submit"
                    class="inline-flex w-full items-center justify-center rounded-full bg-cyan-500 px-5 py-2.5 text-sm font-semibold text-slate-950 transition-colors hover:bg-cyan-400 focus:outline-none focus:ring-2 focus:ring-cyan-500/50">
                Create account
            </button>
            <a asp-action="Index"
               asp-controller="User"
               class="inline-flex items-center justify-center rounded-full bg-slate-800 px-5 py-2.5 text-sm font-medium text-slate-300 transition-colors hover:bg-slate-700 hover:text-white focus:outline-none focus:ring-2 focus:ring-slate-500/50">
                Go back
            </a>

        </form>

    </div>

</div>
