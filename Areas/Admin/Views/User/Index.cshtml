@model PagedResult<UserVM>

@{
    ViewData["Title"] = "Users";
}

<div class="space-y-6">

    <!-- Page header -->
    <div class="flex flex-col gap-4 rounded-2xl border border-slate-800 bg-slate-900 p-6 shadow-lg shadow-slate-950/20 sm:flex-row sm:items-center sm:justify-between">

        <div>
            <p class="text-xs font-semibold uppercase tracking-[0.24em] text-cyan-400">
                Admin
            </p>

            <h1 class="mt-2 text-2xl font-bold tracking-tight text-white sm:text-3xl">
                Users
            </h1>

            <p class="mt-1 text-sm text-slate-400">
                Manage user accounts and roles.
            </p>
        </div>


        <!-- Create user -->
        <a asp-action="Create"
           class="inline-flex items-center justify-center rounded-full bg-cyan-500 px-5 py-2.5 text-sm font-semibold text-slate-950 transition-colors hover:bg-cyan-400 focus:outline-none focus:ring-2 focus:ring-cyan-500/50">
            Create new user
        </a>

    </div>


    <!-- Search -->
    <div class="rounded-xl border border-slate-800 bg-slate-900 p-5 shadow-sm">

        <div class="mb-4">
            <h2 class="text-lg font-semibold text-white">
                Search users
            </h2>

            <p class="mt-1 text-sm text-slate-400">
                Search by name, email, username, or role.
            </p>
        </div>

        <form asp-action="Index"
              method="get"
              class="flex flex-col gap-3 sm:flex-row">

            <label for="SearchString" class="sr-only">
                Search users
            </label>

            <input id="SearchString"
                   type="text"
                   name="SearchString"
                   value="@ViewData["CurrentFilter"]"
                   placeholder="Search users..."
                   class="min-w-0 flex-1 rounded-lg border border-slate-700 bg-slate-950 px-3 py-2.5 text-sm text-white placeholder-slate-500 outline-none transition focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500" />

            <button type="submit"
                    class="inline-flex items-center justify-center rounded-full bg-cyan-500 px-6 py-2.5 text-sm font-semibold text-slate-950 transition-colors hover:bg-cyan-400 focus:outline-none focus:ring-2 focus:ring-cyan-500/50">
                Search
            </button>

        </form>

    </div>


    <!-- Users table -->
    <div class="overflow-hidden rounded-xl border border-slate-800 bg-slate-900 shadow-sm">

        <!-- Table header -->
        <div class="border-b border-slate-800 px-5 py-4">

            <h2 class="text-lg font-semibold text-white">
                User accounts
            </h2>

            <p class="mt-1 text-sm text-slate-400">
                Overview of registered users and their assigned roles.
            </p>

        </div>


        <!-- Table -->
        <div class="overflow-x-auto">

            <table class="w-full text-left text-sm">

                <!-- Head -->
                <thead class="border-b border-slate-800 bg-slate-950/60">

                    <tr>

                        <th class="whitespace-nowrap px-5 py-4 font-semibold text-slate-300">
                            First name
                        </th>

                        <th class="whitespace-nowrap px-5 py-4 font-semibold text-slate-300">
                            Last name
                        </th>

                        <th class="whitespace-nowrap px-5 py-4 font-semibold text-slate-300">
                            Username
                        </th>

                        <th class="whitespace-nowrap px-5 py-4 font-semibold text-slate-300">
                            Email
                        </th>

                        <th class="whitespace-nowrap px-5 py-4 font-semibold text-slate-300">
                            Role
                        </th>

                        <th class="whitespace-nowrap px-5 py-4 text-right font-semibold text-slate-300">
                            Actions
                        </th>

                    </tr>

                </thead>


                <!-- Body -->
                <tbody class="divide-y divide-slate-800">

                    @if (Model.Items.Count() == 0)
                    {
                        <!-- No users -->
                        <tr>

                            <td colspan="6"
                                class="px-5 py-12 text-center">

                                <p class="font-medium text-slate-300">
                                    No users found
                                </p>

                                <p class="mt-1 text-sm text-slate-500">
                                    Try changing your search criteria.
                                </p>

                            </td>

                        </tr>
                    }
                    else
                    {
                        @foreach (var user in Model.Items)
                        {
                            <tr class="transition-colors hover:bg-slate-800/50">

                                <!-- First name -->
                                <td class="whitespace-nowrap px-5 py-4">

                                    <span class="font-medium text-white">
                                        @user.User.FirstName
                                    </span>

                                </td>


                                <!-- Last name -->
                                <td class="whitespace-nowrap px-5 py-4">

                                    <span class="font-medium text-white">
                                        @user.User.LastName
                                    </span>

                                </td>


                                <!-- Username -->
                                <td class="whitespace-nowrap px-5 py-4">

                                    <span class="text-slate-300">
                                        @user.User.UserName
                                    </span>

                                </td>


                                <!-- Email -->
                                <td class="px-5 py-4">

                                    <span class="text-slate-300">
                                        @user.User.Email
                                    </span>

                                </td>


                                <!-- Roles -->
                                <td class="px-5 py-4">

                                    <div class="flex flex-wrap gap-2">

                                        @foreach (var role in user.Roles)
                                        {
                                            <span class="inline-flex items-center rounded-full bg-slate-700 px-2.5 py-1 text-xs font-semibold text-slate-300 ring-1 ring-inset ring-slate-600">
                                                @role
                                            </span>
                                        }

                                    </div>

                                </td>


                                <!-- Actions -->
                                <td class="whitespace-nowrap px-5 py-4">

                                    <div class="flex items-center justify-end gap-2">

                                        <!-- Edit -->
                                        <a asp-action="Edit"
                                           asp-route-id="@user.User.Id"
                                           class="inline-flex items-center rounded-full bg-slate-800 px-3 py-1.5 text-xs font-medium text-slate-300 transition-colors hover:bg-slate-700 hover:text-white">
                                            Edit
                                        </a>


                                        <!-- Delete -->
                                        <a asp-action="Delete"
                                           asp-route-id="@user.User.Id"
                                           class="inline-flex items-center rounded-full bg-red-500/10 px-3 py-1.5 text-xs font-medium text-red-400 ring-1 ring-inset ring-red-500/20 transition-colors hover:bg-red-500/20 hover:text-red-300">
                                            Delete
                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>


        <!-- Pagination -->
        <div class="flex flex-col gap-4 border-t border-slate-800 bg-slate-950/80 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">

            <div class="text-sm text-slate-400">

                Showing
                <span class="font-medium text-slate-300">
                    @Model.Items.Count()
                </span>
                of
                <span class="font-medium text-slate-300">
                    @Model.TotalItems
                </span>
                users

            </div>


            <div class="flex gap-2">

                @if (Model.HasPreviousPage)
                {
                    <a asp-action="Index"
                       asp-route-page="@(Model.PageNumber - 1)"
                       asp-route-searchString="@(ViewData["CurrentFilter"]?.ToString() ?? string.Empty)"
                       class="inline-flex items-center rounded-full bg-slate-800 px-4 py-2 text-sm font-medium text-slate-300 transition-colors hover:bg-slate-700 hover:text-white">
                        Previous
                    </a>
                }


                @if (Model.HasNextPage)
                {
                    <a asp-action="Index"
                       asp-route-page="@(Model.PageNumber + 1)"
                       asp-route-searchString="@(ViewData["CurrentFilter"]?.ToString() ?? string.Empty)"
                       class="inline-flex items-center rounded-full bg-slate-800 px-4 py-2 text-sm font-medium text-slate-300 transition-colors hover:bg-slate-700 hover:text-white">
                        Next
                    </a>
                }

            </div>

        </div>

    </div>

</div>
