@using caseManageMentSystem.Areas.CaseManager.Enums
@model CasesViewModel

@{
    var activeCases = Model.Cases.Count(c => c.Status == Status.active);
    var closedCases = Model.Cases.Count(c => c.Status == Status.closed);
    var waitingCases = Model.Cases.Count(c => c.Status == Status.waiting);
    var delayedCases = Model.Cases.Count(c => c.Status == Status.delayed);
    var totalCases = Model.Cases.Count;

}




<div class="space-y-6">
    <div class="flex flex-col gap-3 rounded-2xl border border-slate-800 bg-slate-900 p-6 shadow-lg shadow-slate-950/20 sm:flex-row sm:items-center sm:justify-between">

        <div>
            <p class="text-xs font-semibold uppercase tracking-[0.24em] text-cyan-400">
                Case Manager Dashboard
            </p>

            <h1 class="mt-2 text-2xl font-bold tracking-tight text-white">
                Welcome, @Model.FullName
            </h1>
        </div>

    </div>
</div>


<div class="mt-6 mb-8">
    <h1 class="text-2xl font-bold text-white">Case statistics</h1>
    <p class="mt-1 text-sm text-slate-400">Overview of your current cases</p>
</div>
<div class="mt-6 mb-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <!-- casse managers total cases -->
    <div class="rounded-xl border p-5">
        <div class="text-sm font-medium ">
            Total cases
        </div>
        <div class="mt-2 text-3xl font-bold">
            @totalCases
        </div>
        
    </div>

    <!-- Active -->
    <div class="rounded-xl border p-5 @(activeCases > 0
                            ? "border-green-500 bg-green-500/10"
                          : "border-slate-700 bg-slate-900")">

        <div class="text-sm font-medium @(activeCases > 0
                                      ? "text-green-400"
                                      : "text-slate-400")">
            Active cases
        </div>

        <div class="mt-2 text-3xl font-bold @(activeCases > 0
                                      ? "text-green-400"
                                      : "text-slate-200")">
            @activeCases
        </div>
    </div>


    <!-- Closed -->
    <div class="rounded-xl border p-5 @(closedCases > 0
                          ? "border-slate-500 bg-slate-500/10"
                          : "border-slate-700 bg-slate-900")">

        <div class="text-sm font-medium @(closedCases > 0
                                      ? "text-slate-300"
                                      : "text-slate-400")">
            Closed cases
        </div>

        <div class="mt-2 text-3xl font-bold @(closedCases > 0
                                      ? "text-slate-200"
                                      : "text-slate-200")">
            @closedCases
        </div>
    </div>


    <!-- Waiting -->
    <div class="rounded-xl border p-5 @(waitingCases > 0
                          ? "border-yellow-500 bg-yellow-500/10"
                          : "border-slate-700 bg-slate-900")">

        <div class="text-sm font-medium @(waitingCases > 0
                                      ? "text-yellow-400"
                                      : "text-slate-400")">
            Waiting cases
        </div>

        <div class="mt-2 text-3xl font-bold @(waitingCases > 0
                                      ? "text-yellow-400"
                                      : "text-slate-200")">
            @waitingCases
        </div>
    </div>


    <!-- Delayed -->
    <div class="rounded-xl border p-5 @(delayedCases > 0
                          ? "border-red-500 bg-red-500/10"
                          : "border-slate-700 bg-slate-900")">

        <div class="text-sm font-medium @(delayedCases > 0
                                      ? "text-red-400"
                                      : "text-slate-400")">
            Delayed cases
        </div>

        <div class="mt-2 text-3xl font-bold @(delayedCases > 0
                                      ? "text-red-400"
                                      : "text-slate-200")">
            @delayedCases
        </div>
    </div>

</div>
<!-- Filtering options-->
<script src="https://cdn.jsdelivr.net/npm/@@tailwindplus/elements@1" type="module"></script> 
<el-dropdown class="inline-block">
    <button class="cursor-pointer inline-flex w-full justify-center gap-x-1.5 rounded-md bg-white/10 px-3 py-2 text-sm font-semibold text-white inset-ring-1 inset-ring-white/5 hover:bg-white/20">
        Filter status
        <svg viewBox="0 0 20 20" fill="currentColor" data-slot="icon" aria-hidden="true" class="-mr-1 size-5 text-gray-400">
            <path d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" fill-rule="evenodd" />
        </svg>
    </button>

    <el-menu anchor="bottom end" popover class="w-56 origin-top-right divide-y divide-white/10 rounded-md bg-gray-800 outline-1 -outline-offset-1 outline-white/10 transition transition-discrete [--anchor-gap:--spacing(2)] data-closed:scale-95 data-closed:transform data-closed:opacity-0 data-enter:duration-100 data-enter:ease-out data-leave:duration-75 data-leave:ease-in">
        <div class="py-1">
            <a asp-action="Index" asp-controller="Dashboard" asp-area="CaseManager" asp-route-caseStatus="" class="block px-4 py-2 text-sm text-gray-300 focus:bg-white/5 focus:text-white focus:outline-hidden">All</a>

            <a asp-action="Index" asp-controller="Dashboard" asp-area="CaseManager" asp-route-caseStatus="active" class="block px-4 py-2 text-sm text-gray-300 focus:bg-white/5 focus:text-white focus:outline-hidden">Active</a>
            <a asp-action="Index" asp-controller="Dashboard" asp-area="CaseManager" asp-route-caseStatus="closed" class="block px-4 py-2 text-sm text-gray-300 focus:bg-white/5 focus:text-white focus:outline-hidden">Closed</a>
       
       
            <a asp-action="Index" asp-controller="Dashboard" asp-area="CaseManager" asp-route-caseStatus="waiting" class="block px-4 py-2 text-sm text-gray-300 focus:bg-white/5 focus:text-white focus:outline-hidden">Waiting</a>
            <a asp-action="Index" asp-controller="Dashboard" asp-area="CaseManager" asp-route-caseStatus="delayed" class="block px-4 py-2 text-sm text-gray-300 focus:bg-white/5 focus:text-white focus:outline-hidden">Delayed</a>
        </div>
    
    </el-menu>
</el-dropdown>
<div class="mt-6 overflow-hidden rounded-xl border border-slate-800 bg-slate-900 shadow-sm">

    <!-- Table header -->
    <div class="border-b border-slate-800 px-5 py-4">
        <h2 class="text-lg font-semibold text-white">
            Managed cases
        </h2>

        <p class="mt-1 text-sm text-slate-400">
            Overview of the cases you are currently managing.
        </p>
    </div>

    <!-- Table -->
    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">

            <!-- Head -->
            <thead class="border-b border-slate-800 bg-slate-950/60">
                <tr>
                    <th class="px-5 py-4 font-semibold text-slate-300">
                        Client
                    </th>

                    <th class="px-5 py-4 font-semibold text-slate-300">
                        Title
                    </th>

                    <th class="px-5 py-4 font-semibold text-slate-300">
                        Status
                    </th>

                    <th class="px-5 py-4 font-semibold text-slate-300">
                        Description
                    </th>

                    <th class="px-5 py-4 font-semibold text-slate-300">
                        Actions
                    </th>
                </tr>
            </thead>

            <!-- Body -->
            <tbody class="divide-y divide-slate-800">

                @if (Model.Cases.Any())
                {
                    @foreach (var caseItem in Model.Cases.Where(c =>
    Model.CaseStatus == null || c.Status == Model.CaseStatus))
                    {
                        <tr class="transition-colors hover:bg-slate-800/50">

                            <!-- Client -->
                            <td class="whitespace-nowrap px-5 py-4">
                                <span class="font-medium text-white">
                                    @caseItem.CaseManager.FullName
                                </span>
                            </td>

                            <!-- Title -->
                            <td class="px-5 py-4">
                                <span class="font-medium text-slate-200">
                                    @caseItem.Title
                                </span>
                            </td>

                            <!-- Status -->
                            <td class="whitespace-nowrap px-5 py-4">

                                @if (caseItem.Status == Status.active)
                                {
                                    <span class="inline-flex items-center rounded-full bg-green-500/10 px-2.5 py-1 text-xs font-semibold text-green-400 ring-1 ring-inset ring-green-500/20">
                                        <span class="mr-1.5 h-1.5 w-1.5 rounded-full bg-green-400"></span>
                                        Active
                                    </span>
                                }
                                else if (caseItem.Status == Status.closed)
                                {
                                    <span class="inline-flex items-center rounded-full bg-slate-700 px-2.5 py-1 text-xs font-semibold text-slate-300 ring-1 ring-inset ring-slate-600">
                                        <span class="mr-1.5 h-1.5 w-1.5 rounded-full bg-slate-400"></span>
                                        Closed
                                    </span>
                                }
                                else if (caseItem.Status == Status.delayed)
                                {
                                    <span class="inline-flex items-center rounded-full bg-red-500/10 px-2.5 py-1 text-xs font-semibold text-slate-300 ring-1 ring-inset ring-red-600">
                                        <span class="mr-1.5 h-1.5 w-1.5 rounded-full bg-red-400"></span>
                                        Delayed
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center rounded-full bg-yellow-500/10 px-2.5 py-1 text-xs font-semibold text-yellow-400 ring-1 ring-inset ring-yellow-500/20">
                                        <span class="mr-1.5 h-1.5 w-1.5 rounded-full bg-yellow-400"></span>
                                        Waiting
                                    </span>
                                }

                            </td>

                            <!-- Description -->
                            <td class="max-w-md px-5 py-4">
                                <p class="truncate text-slate-400">
                                    @caseItem.Description
                                </p>
                            </td>

                            <!-- Actions -->
                            <td class="whitespace-nowrap px-5 py-4">

                                <button type="button"
                                        class="rounded-lg px-3 py-2 text-xs font-medium text-slate-300 transition-colors hover:bg-slate-800 hover:text-white">
                                    View
                                </button>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <!-- No cases -->
                    <tr>
                        <td colspan="5" class="px-5 py-12 text-center">

                            <p class="font-medium text-slate-300">
                                No cases found
                            </p>

                            <p class="mt-1 text-sm text-slate-500">
                                You currently don't have any managed cases.
                            </p>

                        </td>
                    </tr>
                }

            </tbody>
        </table>
    </div>

</div>

