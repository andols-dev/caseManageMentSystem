@model ApplicationUser
<h1>Case Manager dashboard</h1>

<p>Welcome @Model.FirstName</p>



<h2>My cases</h2>
@if (Model.ManagedCases.Any())
{
    foreach (var client in Model.ManagedCases)
    {
        <p>@client.Status</p>
        <p>@client.Title</p>
        <p>@client.Client.FullName</p>
    }
}
else
{
    <p>no clients</p>
}

