@model ApplicationUser


<div>
    <button>Create a case</button> <!--move button to the right-->
    @if (Model.ClientCases.FirstOrDefault()?.CaseManager != null)
    {
        <p>
            Case Manager: @Model.ClientCases?.FirstOrDefault()?.CaseManager.FullName
        </p>
    }

    <div class="px-4 sm:px-0">
        <h3 class="text-base/7 font-semibold text-white">Client Information</h3>
    </div>

    <div class="mt-6 border-t border-gray-100">
        <dl class="divide-y divide-gray-100">

            <div class="px-4 py-6 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-0">
                <dt class="text-sm/6 font-medium text-white">
                    Name
                </dt>

                <dd class="mt-1 text-sm/6 text-white sm:col-span-2 sm:mt-0">
                    @Model.FullName
                </dd>
            </div>

            <div class="px-4 py-6 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-0">
                <dt class="text-sm/6 font-medium text-white">
                    Email address
                </dt>

                <dd class="mt-1 text-sm/6 text-white sm:col-span-2 sm:mt-0">
                    @Model.Email
                </dd>
            </div>
        </dl>
    </div>
</div>
@if(Model.ClientCases.Any())
{
    <h1>Cases</h1>
    @foreach (var caseItem in Model.ClientCases)
    {
        
       <div>@caseItem.CaseNumber</div>
    } 

}

else
{
    <div>
        <p>No cases</p>
    </div>
}
