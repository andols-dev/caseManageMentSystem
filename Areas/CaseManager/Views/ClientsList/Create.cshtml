@using caseManageMentSystem.Areas.CaseManager.ViewModels
@model CreateCaseViewModel

<div class="space-y-6">

    <!-- Header -->
    <div class="rounded-2xl border border-slate-800 bg-slate-900 p-6 shadow-lg shadow-slate-950/20">

        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-cyan-400">
            Case Manager
        </p>

        <h1 class="mt-2 text-2xl font-bold tracking-tight text-white">
            Create case
        </h1>

        <p class="mt-1 text-sm text-slate-400">
            Create a new case for this client.
        </p>

    </div>


    <!-- Form -->
    <div class="overflow-hidden rounded-xl border border-slate-800 bg-slate-900 shadow-sm">

        <div class="border-b border-slate-800 px-5 py-4">
            <h2 class="text-lg font-semibold text-white">
                Case information
            </h2>

            <p class="mt-1 text-sm text-slate-400">
                Enter the information for the new case.
            </p>
        </div>


        <form asp-action="Create" method="post" class="space-y-6 p-5">

            <!-- Client ID -->
            <input asp-for="ClientId" type="hidden" />


            <!-- Title -->
            <div>
                <label asp-for="Title"
                       class="block text-sm font-medium text-slate-300">
                    Title
                </label>

                <input asp-for="Title"
                       class="mt-2 block w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2.5 text-sm text-white placeholder-slate-500 outline-none transition focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500"
                       placeholder="Enter case title..." />

                <span asp-validation-for="Title"
                      class="mt-1 block text-sm text-red-400">
                </span>
            </div>


            <!-- Description -->
            <div>
                <label asp-for="Description"
                       class="block text-sm font-medium text-slate-300">
                    Description
                </label>

                <textarea asp-for="Description"
                          rows="5"
                          class="mt-2 block w-full resize-y rounded-lg border border-slate-700 bg-slate-950 px-3 py-2.5 text-sm text-white placeholder-slate-500 outline-none transition focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500"
                          placeholder="Describe the case..."></textarea>

                <span asp-validation-for="Description"
                      class="mt-1 block text-sm text-red-400">
                </span>
            </div>


            <!-- Actions -->
            <div class="flex flex-col-reverse gap-3 border-t border-slate-800 pt-5 sm:flex-row sm:justify-end">

                <a asp-action="Details"
                   asp-controller="ClientsList"
                   asp-area="CaseManager"
                   asp-route-id="@ViewBag.clientId"
                   class="inline-flex items-center justify-center rounded-full bg-slate-800 px-4 py-2 text-sm font-medium text-slate-300 transition-colors hover:bg-slate-700 hover:text-white">
                    Go back
                </a>

                <button type="submit"
                        class="inline-flex items-center justify-center rounded-full bg-cyan-500 px-4 py-2 text-sm font-semibold text-slate-950 transition-colors hover:bg-cyan-400">
                    Create case
                </button>

            </div>

        </form>

    </div>

</div>
