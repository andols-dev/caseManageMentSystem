@using caseManageMentSystem.Areas.CaseManager.ViewModels
@model CreateCaseViewModel 
<h1>Create case</h1>

<form asp-action="Create">
    <!-- get the client id-->
    <input asp-for="ClientId" type="hidden" />
    
    <!--Add a title -->
    <label asp-for="Title">Title</label>
    <input asp-for="Title" />
    <span class="text-red-950" asp-validation-for="Title"></span>

    <!-- Add a description-->
    <label asp-for="Description"></label>
    <input asp-for="Description" />
    <span asp-validation-for="Description" class="text-red-950"></span>


    <button type="submit">Create</button>
</form>

<a asp-action="Details" asp-controller="ClientsList" asp-area="caseManager" asp-route-id="@ViewBag.clientId">Go back</a>