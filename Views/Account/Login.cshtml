@{
    ViewData["Title"] = "Sign In";
}

@model caseManageMentSystem.Models.LoginUser

<div class="flex min-h-[calc(100vh-6rem)] items-center justify-center py-12">

    <div class="w-full max-w-lg space-y-6">

        <!-- Header -->
        <div class="rounded-2xl border border-slate-800 bg-slate-900 p-6 text-center shadow-lg shadow-slate-950/20">

            <p class="text-xs font-semibold uppercase tracking-[0.24em] text-cyan-400">
                Case Management System
            </p>

            <h1 class="mt-2 text-2xl font-bold tracking-tight text-white sm:text-3xl">
                Sign in
            </h1>

            <p class="mt-1 text-sm text-slate-400">
                Sign in to access your account.
            </p>

        </div>


        <!-- Login form -->
        <div class="overflow-hidden rounded-xl border border-slate-800 bg-slate-900 shadow-sm">

            <!-- Form header -->
            <div class="border-b border-slate-800 px-5 py-4">
                <h2 class="text-lg font-semibold text-white">
                    Account login
                </h2>

                <p class="mt-1 text-sm text-slate-400">
                    Enter your email address and password.
                </p>
            </div>


            <form asp-action="Login"
                  method="post"
                  class="space-y-6 p-5">

                <!-- Validation summary -->
                @if (ViewBag.Error != null && ViewBag.Error == true)
                {
                    <div asp-validation-summary="All"
                         class="rounded-lg border border-red-500/30 bg-red-500/10 px-4 py-3 text-sm text-red-400">
                    </div>
                }


                <!-- Email -->
                <div>
                    <label asp-for="Email"
                           class="block text-sm font-medium text-slate-300">
                        Email address
                    </label>

                    <input asp-for="Email"
                           type="email"
                           autocomplete="email"
                           class="mt-2 block w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2.5 text-sm text-white placeholder-slate-500 outline-none transition focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500"
                           placeholder="you@example.com" />

                    <span asp-validation-for="Email"
                          class="mt-1 block text-sm text-red-400">
                    </span>
                </div>


                <!-- Password -->
                <div>
                    <label asp-for="Password"
                           class="block text-sm font-medium text-slate-300">
                        Password
                    </label>

                    <input asp-for="Password"
                           type="password"
                           autocomplete="current-password"
                           class="mt-2 block w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2.5 text-sm text-white placeholder-slate-500 outline-none transition focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500"
                           placeholder="Enter your password" />

                    <span asp-validation-for="Password"
                          class="mt-1 block text-sm text-red-400">
                    </span>
                </div>


                <!-- Remember me -->
                <div>
                    <label class="inline-flex cursor-pointer items-center text-sm text-slate-400">

                        <input asp-for="RememberMe"
                               type="checkbox"
                               class="h-4 w-4 rounded border-slate-700 bg-slate-950 text-cyan-500 focus:ring-2 focus:ring-cyan-500/20" />

                        <span class="ml-2">
                            Remember me
                        </span>

                    </label>
                </div>


                <!-- Submit -->
                <button type="submit"
                        class="inline-flex w-full items-center justify-center rounded-full bg-cyan-500 px-5 py-2.5 text-sm font-semibold text-slate-950 transition-colors hover:bg-cyan-400 focus:outline-none focus:ring-2 focus:ring-cyan-500/50">
                    Sign in
                </button>

            </form>

        </div>

    </div>

</div>
