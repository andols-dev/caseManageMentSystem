@model caseManageMentSystem.ViewModels.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change password";
}

<div class="space-y-6">

    <!-- Header -->
    <div class="rounded-2xl border border-slate-800 bg-slate-900 p-6 shadow-lg shadow-slate-950/20">

        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-cyan-400">
            Account settings
        </p>

        <h1 class="mt-2 text-2xl font-bold tracking-tight text-white">
            Change password
        </h1>

        <p class="mt-1 text-sm text-slate-400">
            Update your password to keep your account secure.
        </p>

    </div>


    <!-- Change password form -->
    <div class="overflow-hidden rounded-xl border border-slate-800 bg-slate-900 shadow-sm">

        <!-- Form header -->
        <div class="border-b border-slate-800 px-5 py-4">
            <h2 class="text-lg font-semibold text-white">
                Password
            </h2>

            <p class="mt-1 text-sm text-slate-400">
                Enter your current password and choose a new one.
            </p>
        </div>


        <form asp-action="ChangePassword"
              method="post"
              class="space-y-6 p-5">

            <!-- Current password -->
            <div>
                <label asp-for="CurrentPassword"
                       class="block text-sm font-medium text-slate-300">
                    Current Password
                </label>

                <input asp-for="CurrentPassword"
                       type="password"
                       class="mt-2 block w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2.5 text-sm text-white placeholder-slate-500 outline-none transition focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500"
                       autocomplete="current-password" />

                <span asp-validation-for="CurrentPassword"
                      class="mt-1 block text-sm text-red-400">
                </span>
            </div>


            <!-- New password -->
            <div>
                <label asp-for="NewPassword"
                       class="block text-sm font-medium text-slate-300">
                    New Password
                </label>

                <input asp-for="NewPassword"
                       type="password"
                       class="mt-2 block w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2.5 text-sm text-white placeholder-slate-500 outline-none transition focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500"
                       autocomplete="new-password" />

                <span asp-validation-for="NewPassword"
                      class="mt-1 block text-sm text-red-400">
                </span>
            </div>


            <!-- Confirm password -->
            <div>
                <label asp-for="ConfirmPassword"
                       class="block text-sm font-medium text-slate-300">
                    Confirm New Password
                </label>

                <input asp-for="ConfirmPassword"
                       type="password"
                       class="mt-2 block w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2.5 text-sm text-white placeholder-slate-500 outline-none transition focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500"
                       autocomplete="new-password" />

                <span asp-validation-for="ConfirmPassword"
                      class="mt-1 block text-sm text-red-400">
                </span>
            </div>


            <!-- Actions -->
            <div class="flex flex-col gap-3 border-t border-slate-800 pt-5 sm:flex-row sm:justify-end">

                <a asp-action="UserProfile"
                   class="inline-flex items-center justify-center rounded-full bg-slate-800 px-4 py-2 text-sm font-medium text-slate-300 transition-colors hover:bg-slate-700 hover:text-white">
                    Cancel
                </a>

                <button type="submit"
                        class="inline-flex items-center justify-center rounded-full bg-cyan-500 px-4 py-2 text-sm font-semibold text-slate-950 transition-colors hover:bg-cyan-400">
                    Save New Password
                </button>

            </div>

        </form>

    </div>

</div>
