<section class="relative overflow-hidden bg-slate-950 text-slate-100">
    <div class="absolute inset-x-0 top-0 -z-10 h-72 bg-gradient-to-b from-cyan-600 via-slate-900 to-slate-950 opacity-90">
    </div>

    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-8">
        <div class="lg:grid lg:grid-cols-2 lg:items-center lg:gap-20">

            <div class="max-w-xl">
                <p class="inline-flex rounded-full bg-cyan-500/15 px-4 py-1 text-sm font-semibold uppercase tracking-[0.24em] text-cyan-300 ring-1 ring-cyan-500/20">
                    Case Management System
                </p>

                <h1 class="mt-8 text-4xl font-semibold tracking-tight text-white sm:text-5xl lg:text-6xl">
                    Manage your cases in one place.
                </h1>

                <p class="mt-6 text-lg leading-8 text-slate-300">
                    A simple and secure platform for creating, tracking, and managing cases.
                </p>

                <div class="mt-10 flex flex-col gap-4 sm:flex-row">
                    <a asp-controller="Account" asp-action="Login"
                       class="inline-flex items-center justify-center rounded-full bg-cyan-500 px-8 py-3 text-sm font-semibold text-slate-950 transition hover:bg-cyan-400">
                        Sign In
                    </a>

                    <a href="#features"
                       class="inline-flex items-center justify-center rounded-full border border-slate-700 bg-slate-900/80 px-8 py-3 text-sm font-semibold text-slate-100 transition hover:border-slate-500 hover:bg-slate-800">
                        Learn More
                    </a>
                </div>
            </div>

            <div class="mt-16 sm:mt-20 lg:mt-0">
                <div class="relative mx-auto max-w-lg overflow-hidden rounded-[2rem] border border-slate-700 bg-slate-900/80 p-8 shadow-2xl shadow-slate-950/50 sm:p-10">

                    <div class="absolute -right-10 -top-10 h-32 w-32 rounded-full bg-cyan-500/20 blur-3xl"></div>
                    <div class="absolute -left-8 bottom-12 h-24 w-24 rounded-full bg-slate-500/10 blur-3xl"></div>

                    <div class="space-y-6">

                        <div class="rounded-3xl bg-slate-950/90 p-6 ring-1 ring-white/5">
                            <p class="text-sm uppercase tracking-[0.24em] text-cyan-300">
                                Dashboard
                            </p>

                            <h2 class="mt-4 text-2xl font-semibold text-white">
                                Keep track of every case.
                            </h2>

                            <p class="mt-3 text-sm leading-6 text-slate-400">
                                View active cases, monitor progress, and stay organized.
                            </p>
                        </div>

                        <div class="grid gap-4 sm:grid-cols-2">

                            <div class="rounded-3xl border border-slate-700 bg-slate-900/90 p-5">
                                <p class="text-sm uppercase tracking-[0.18em] text-slate-400">
                                    Cases
                                </p>

                                <p class="mt-3 text-xl font-semibold text-white">
                                    Active & Closed
                                </p>
                            </div>

                            <div class="rounded-3xl border border-slate-700 bg-slate-900/90 p-5">
                                <p class="text-sm uppercase tracking-[0.18em] text-slate-400">
                                    Status
                                </p>

                                <p class="mt-3 text-xl font-semibold text-white">
                                    Easy Tracking
                                </p>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

        </div>

        <section id="features" class="mt-24 grid gap-8 lg:grid-cols-3">

            <div class="rounded-3xl border border-slate-800 bg-slate-900/80 p-8 shadow-slate-950/10">
                <div class="inline-flex rounded-full bg-cyan-500/10 px-3 py-1 text-sm font-semibold text-cyan-300">
                    Cases
                </div>

                <h3 class="mt-6 text-2xl font-semibold text-white">
                    Manage Cases
                </h3>

                <p class="mt-4 text-sm leading-6 text-slate-400">
                    Create, update, and organize all your cases from a single dashboard.
                </p>

                <ul class="mt-6 space-y-3 text-slate-300">
                    <li class="flex gap-3"><span class="mt-1 h-2.5 w-2.5 rounded-full bg-cyan-400"></span>Create new cases</li>
                    <li class="flex gap-3"><span class="mt-1 h-2.5 w-2.5 rounded-full bg-cyan-400"></span>Track case progress</li>
                    <li class="flex gap-3"><span class="mt-1 h-2.5 w-2.5 rounded-full bg-cyan-400"></span>Update case details</li>
                </ul>
            </div>

            <div class="rounded-3xl border border-slate-800 bg-slate-900/80 p-8 shadow-slate-950/10">
                <div class="inline-flex rounded-full bg-slate-700/60 px-3 py-1 text-sm font-semibold text-slate-200">
                    Users
                </div>

                <h3 class="mt-6 text-2xl font-semibold text-white">
                    Team Collaboration
                </h3>

                <p class="mt-4 text-sm leading-6 text-slate-400">
                    Give team members access to the cases they are responsible for.
                </p>

                <ul class="mt-6 space-y-3 text-slate-300">
                    <li class="flex gap-3"><span class="mt-1 h-2.5 w-2.5 rounded-full bg-cyan-400"></span>Role-based access</li>
                    <li class="flex gap-3"><span class="mt-1 h-2.5 w-2.5 rounded-full bg-cyan-400"></span>Shared case overview</li>
                    <li class="flex gap-3"><span class="mt-1 h-2.5 w-2.5 rounded-full bg-cyan-400"></span>Efficient workflows</li>
                </ul>
            </div>

            <div class="rounded-3xl border border-slate-800 bg-slate-900/80 p-8 shadow-slate-950/10">
                <div class="inline-flex rounded-full bg-slate-700/60 px-3 py-1 text-sm font-semibold text-slate-200">
                    Security
                </div>

                <h3 class="mt-6 text-2xl font-semibold text-white">
                    Secure by Design
                </h3>

                <p class="mt-4 text-sm leading-6 text-slate-400">
                    Protect your data with secure authentication and controlled access.
                </p>

                <ul class="mt-6 space-y-3 text-slate-300">
                    <li class="flex gap-3"><span class="mt-1 h-2.5 w-2.5 rounded-full bg-cyan-400"></span>Secure authentication</li>
                    <li class="flex gap-3"><span class="mt-1 h-2.5 w-2.5 rounded-full bg-cyan-400"></span>Role-based permissions</li>
                    <li class="flex gap-3"><span class="mt-1 h-2.5 w-2.5 rounded-full bg-cyan-400"></span>Protected data storage</li>
                </ul>
            </div>

        </section>

        <section id="get-started"
                 class="mt-24 rounded-[2rem] border border-slate-800 bg-slate-900/80 p-10 text-center shadow-2xl shadow-slate-950/20">

            <p class="text-sm uppercase tracking-[0.24em] text-cyan-300">
                Get Started
            </p>

            <h2 class="mt-4 text-3xl font-semibold text-white sm:text-4xl">
                Everything you need to manage cases.
            </h2>

            <p class="mx-auto mt-6 max-w-2xl text-base leading-7 text-slate-400">
                Sign in to create, manage, and track your cases in a simple and secure environment.
            </p>

            <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
                <a asp-controller="Account" asp-action="Login"
                   class="inline-flex items-center justify-center rounded-full bg-cyan-500 px-8 py-3 text-sm font-semibold text-slate-950 transition hover:bg-cyan-400">
                    Sign In
                </a>

                <a href="#features"
                   class="inline-flex items-center justify-center rounded-full border border-slate-700 bg-transparent px-8 py-3 text-sm font-semibold text-slate-200 transition hover:border-slate-500 hover:bg-slate-800">
                    Learn More
                </a>
            </div>

        </section>
    </div>
</section>