@using Microsoft.AspNetCore.Identity
@using caseManageMentSystem.Models
@inject SignInManager<ApplicationUser> SignInManager

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="stylesheet" href="~/css/output.css">

    <title>Case Management System</title>
</head>

<body class="bg-slate-950 text-slate-100 antialiased">

    <div class="flex min-h-screen flex-col bg-slate-950">

        <!-- Navigation -->
        <nav class="border-b border-slate-800 bg-slate-900/95 shadow-sm backdrop-blur-xl">

            <div class="mx-auto flex w-full max-w-7xl flex-col gap-4 px-6 py-4 lg:flex-row lg:items-center lg:justify-between lg:px-8">

                <!-- Logo + Navigation -->
                <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-8">

                    <!-- Logo -->
                    <a asp-area=""
                       asp-controller="Home"
                       asp-action="Index"
                       class="text-lg font-bold tracking-tight text-white transition-colors hover:text-cyan-400">
                        Case
                        <span class="text-cyan-400">
                            Management
                        </span>
                        System
                    </a>


                    <!-- Navigation links -->
                    <div class="flex flex-wrap items-center gap-2">

                        @if (SignInManager.IsSignedIn(User) && User.IsInRole("admin"))
                        {
                            <a asp-area="Admin"
                               asp-controller="User"
                               asp-action="Index"
                               class="rounded-lg px-3 py-2 text-sm font-medium text-slate-300 transition-colors hover:bg-slate-800 hover:text-white">
                                Admin
                            </a>
                        }


                        @if (SignInManager.IsSignedIn(User) && User.IsInRole("caseManager"))
                        {
                            <a asp-area="CaseManager"
                               asp-controller="Dashboard"
                               asp-action="Index"
                               class="rounded-lg px-3 py-2 text-sm font-medium text-slate-300 transition-colors hover:bg-slate-800 hover:text-white">
                                My Dashboard
                            </a>

                            <a asp-area="CaseManager"
                               asp-controller="ClientsList"
                               asp-action="Index"
                               class="rounded-lg px-3 py-2 text-sm font-medium text-slate-300 transition-colors hover:bg-slate-800 hover:text-white">
                                Clients
                            </a>
                        }

                    </div>

                </div>


                <!-- Account -->
                <div class="flex items-center">
                    @await Html.PartialAsync("_LoginPartial")
                </div>

            </div>

        </nav>


        <!-- Main content -->
        <main class="mx-auto w-full max-w-7xl flex-1 px-6 py-8 lg:px-8 lg:py-10">

            @RenderBody()

        </main>


        <!-- Footer -->
        <footer class="border-t border-slate-800 bg-slate-950/90">

            <div class="mx-auto flex w-full max-w-7xl flex-col gap-4 px-6 py-6 sm:flex-row sm:items-center sm:justify-between lg:px-8">

                <!-- Copyright -->
                <div>
                    <p class="text-sm font-medium text-slate-300">
                        Case Management System
                    </p>

                    <p class="mt-1 text-xs text-slate-500">
                        Secure case management platform
                    </p>
                </div>


                <!-- Footer links -->
                <div class="flex flex-wrap items-center gap-2">

                    <a href="#"
                       class="rounded-lg px-3 py-2 text-sm text-slate-400 transition-colors hover:bg-slate-900 hover:text-white">
                        Privacy
                    </a>

                    <a href="#"
                       class="rounded-lg px-3 py-2 text-sm text-slate-400 transition-colors hover:bg-slate-900 hover:text-white">
                        Terms
                    </a>

                    <a href="#"
                       class="rounded-lg px-3 py-2 text-sm text-slate-400 transition-colors hover:bg-slate-900 hover:text-white">
                        Support
                    </a>

                </div>

            </div>

        </footer>

    </div>

</body>

</html>
